# Maintainer: apiplant <releases@apiplant.com>
#
# Built by the release workflow, which fills in the version and checksum and
# publishes the resulting package to apiplant.github.io/pacman. It is not an
# AUR manifest: it installs the binaries the release already built.
pkgname=chess-vision-rs
pkgver=@VERSION@
pkgrel=1
pkgdesc="Recognise a chess position from an image and print FEN, Lichess links or a rendered board"
arch=('x86_64')
url="https://github.com/apiplant/chess-vision-rs"
license=('AGPL3')
depends=()
# The release archive holding the binaries and the README. The workflow builds
# the package before the release exists and drops the archive next to this
# file, which makepkg picks up instead of downloading; the URL is what makes
# the PKGBUILD work on its own once the release is published.
source=("$pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/chess-vision-rs-v$pkgver-x86_64-unknown-linux-gnu.tar.gz")
sha256sums=('@SHA_LINUX_X86_64@')
# The release profile already strips symbols, and makepkg's strip pass on an
# LTO'd binary buys nothing.
options=('!strip' '!debug')

package() {
  local src="$srcdir/chess-vision-rs-v$pkgver-x86_64-unknown-linux-gnu"
  install -Dm755 "$src/chess-vision" "$pkgdir/usr/bin/chess-vision"
  install -Dm644 "$src/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
